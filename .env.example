# Environment Variables Example
# Copy this file to `.env` and fill in actual values for local development.
# NEVER commit `.env` with real secrets.

# API Keys (placeholders – replace with actual keys in your environment)
API_KEY=your_api_key_here
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Application Settings
LOG_LEVEL=info
DEBUG=false
PORT=3000

# External Services
SENTRY_DSN=your_sentry_dsn_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# Feature Flags
ENABLE_FEATURE_X=false
ENABLE_FEATURE_Y=true

# Placeholder for other environment‑specific variables
# CUSTOM_VAR=value